{
  "name": "yeying-wallet",
  "version": "1.4.23",
  "private": true,
  "//": "devDependencies only — 单元测试夹具所需；运行时扩展不依赖 npm 包（lib/ 下 vendored）。E2E 已下放到 ../tester，本仓不再装 Playwright。",
  "type": "module",
  "scripts": {
    "test": "node --test --test-force-exit --test-concurrency=1 $(find tests -maxdepth 1 -name '*.test.mjs' ! -name 'sync-service.test.mjs' ! -name 'change-password-edges.test.mjs' -print) && node --test --test-force-exit --experimental-test-isolation=none tests/change-password-edges.test.mjs",
    "test:sync": "node --test --test-force-exit --experimental-test-isolation=none tests/sync-service.test.mjs",
    "test:approval": "node --experimental-vm-modules tests/test-approval-flow.mjs",
    "test:all": "npm run test && npm run test:sync",
    "typecheck": "npx -y -p typescript@5 tsc -p tsconfig.json",
    "mpc:wasm:check": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo check --manifest-path experiments/mpc-cggmp24-spike/Cargo.toml --target wasm32-unknown-unknown",
    "mpc:wasm:build": "scripts/build-cggmp24-wasm.sh"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0"
  }
}
